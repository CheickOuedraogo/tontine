# Configuration Production - NE PAS COMMITER CE FICHIER AVEC VOS VRAIES VALEURS

# Base de données PostgreSQL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@db.example.com:5432/tontine_prod

# Secrets JWT - GÉNÉRER DES VALEURS ALÉATOIRES LONGUES ET SÉCURISÉES
# Utiliser: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_secret_jwt_production_tres_long_et_securise
JWT_REFRESH_SECRET=votre_secret_refresh_production_tres_long_et_securise

# MailerSend Configuration
# Obtenir votre token sur: https://app.mailersend.com/tokens
MAILERSEND_API_KEY=mlsn.votre_token_production
MAIL_FROM_EMAIL=noreply@votredomaine.com
MAIL_FROM_NAME=Tontine

# URL Frontend (pour CORS et liens emails)
FRONTEND_URL=https://votreapp.com

# Port serveur
PORT=3000

# Optionnel: Niveau de logs
LOG_LEVEL=info

# Optionnel: Limite de requêtes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
